{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godsuite.dev/schemas/godsdk-config.schema.json",
  "title": "GodSDK generated repository configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "spec", "targets", "release"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "allow_remote_refs"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "allow_remote_refs": {"type": "boolean"},
        "remote_ref_hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "remote_ref_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["rust", "python", "typescript"]}
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "crates_io", "pypi", "npm", "github"],
      "properties": {
        "enabled": {"type": "boolean"},
        "crates_io": {"$ref": "#/$defs/crates_io"},
        "pypi": {"$ref": "#/$defs/package_registry"},
        "npm": {
          "allOf": [
            {"$ref": "#/$defs/package_registry"},
            {
              "type": "object",
              "required": ["publish_provenance"],
              "properties": {"publish_provenance": {"type": "boolean"}}
            }
          ]
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "workflow"],
          "properties": {
            "enabled": {"type": "boolean"},
            "workflow": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "package_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "package"],
      "properties": {
        "enabled": {"type": "boolean"},
        "package": {"type": "string", "minLength": 1}
      }
    },
    "crates_io": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "package"],
      "properties": {
        "enabled": {"type": "boolean"},
        "package": {"type": "string", "minLength": 1}
      }
    }
  }
}
