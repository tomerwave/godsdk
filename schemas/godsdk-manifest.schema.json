{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godsuite.dev/schemas/godsdk-manifest.schema.json",
  "title": "GodSDK generated repository manifest",
  "description": "Ownership and reproducibility metadata for a GodSDK-generated repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_version",
    "template_set_version",
    "input",
    "targets",
    "governance",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generator_version": {
      "$ref": "#/$defs/version"
    },
    "template_set_version": {
      "$ref": "#/$defs/version"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "resolved_refs"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolved_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "sha256"],
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["rust", "python", "typescript"]
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["godlint", "godharness", "bundle_version"],
      "properties": {
        "godlint": {
          "$ref": "#/$defs/version"
        },
        "godharness": {
          "$ref": "#/$defs/version"
        },
        "bundle_version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generated_file"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "target", "template", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "target": {
          "type": "string",
          "enum": ["shared", "rust", "python", "typescript"]
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
